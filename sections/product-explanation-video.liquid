<style>
  .product-explanation-video-section{background:{{section.settings.bg_color}};padding:{{section.settings.vertical_padding}}px 15px}
  .product-explanation-video-main{max-width:712px;width:100%;margin:0 auto}
  .product-explanation-video-uppercnt{max-width:600px;width:100%;margin:0 auto;text-align:center}
  .product-explanation-video-uppercnt h6{font-weight:500;margin-bottom:6px;text-align:center}
  .product-explanation-video-title{font-size:{{section.settings.heading_size}}px;font-weight:500;margin:0;text-align:center;font-family:sans-serif}
  .product-explanation-video-uppercnt p{text-align:center;margin:16px 0 30px}
  .product-explanation-video-item{position:relative;width:100%;overflow:hidden}
  .product-explanation-video-item img,.product-explanation-video-placeholder{display:block;width:100%;height:100%;object-fit:cover}
  .product-explanation-video-placeholder{background:rgba(var(--color-foreground),.04)}
  @media screen and (max-width:767px){.product-explanation-video-section{padding:{{section.settings.vertical_padding_mobile}}px 15px}.product-explanation-video-uppercnt h6{font-size:14px}}
  {% for c in section.blocks %}{% case c.type %}{% when 'heading' %}.akta-{{section.id}} .heading-font{{forloop.index}}{font-size:{{c.settings.h1_font_size}}px;font-weight:{{c.settings.h1_font_weight}};text-align:{{c.settings.h1_text_align}};padding-top:{{c.settings.padding_top}}px;padding-bottom:{{c.settings.padding_bottom}}px}@media (max-width:1024px){.akta-{{section.id}} .heading-font{{forloop.index}}{font-size:{{c.settings.h1_font_size_tablet}}px;padding-top:{{c.settings.padding_top_tablet | default: settings.padding_top}}px;padding-bottom:{{c.settings.padding_bottom_tablet | default: settings.padding_bottom}}px}}@media (max-width:768px){.akta-{{section.id}} .heading-font{{forloop.index}}{font-size:{{c.settings.h1_font_size_mobile}}px;padding-top:{{c.settings.padding_top_mobile | default: settings.padding_top}}px;padding-bottom:{{c.settings.padding_bottom_mobile | default: settings.padding_bottom}}px}}{% endcase %}{% endfor %}
</style>
<div class="m-color-{{ section.settings.color_scheme }}">
  <div class="product-explanation-video-section akta-{{ section.id}}">
    <div class="product-explanation-video-main">
      <div class="product-explanation-video-uppercnt">
        {% for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'sub_heading' -%}
              <span class="{{ section.settings.sub_heading }}">{{ block.settings.sub_heading }}</span>
            {%- when 'heading' %}
              <h3 class="{{ section.settings.heading_type }}">{{ block.settings.heading }}</h3>
            {% when 'details' %}
              <p class="description-font{{forloop.index}} {{ section.settings.des_size}}">
                {{ block.settings.details }}
              </p>
          {% endcase -%}
        {%- endfor %}
      </div>
      {% for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'video' %}
            <div class="product-explanation-video-item {{ block.id }}" {{ block.shopify_attributes }}>
              <style>
                .product-explanation-video-item.{{ block.id }}{margin-top:{{ block.settings.video_mt }}px;aspect-ratio:{{ block.settings.image_ratio | default: '16/9' }};{% if block.settings.image_ratio == '1/1' %}max-height:712px{% else %}max-height:400px{% endif %}}
              </style>
              {% assign explanation_image = block.settings.explanation_video_poster -%}
              {%- if explanation_image != blank -%}
                {{-
                  explanation_image
                  | image_url: width: 1600
                  | image_tag:
                    widths: '360,480,640,712,960,1200,1600',
                    sizes: '(min-width: 742px) 712px, calc(100vw - 30px)',
                    loading: 'lazy',
                    class: 'product-explanation-video-image',
                    alt: explanation_image.alt
                -}}
              {%- else -%}
                {{- 'lifestyle-1' | placeholder_svg_tag: 'product-explanation-video-placeholder' -}}
              {%- endif %}
            </div>
        {% endcase -%}
      {%- endfor %}
    </div>
  </div>
</div>
{% schema %}{"name":"APEX Pr Explanation Photo","settings":[{"type":"color_scheme","id":"color_scheme","label":"Color scheme"},{"type":"range","id":"vertical_padding","label":"Vertical padding","default":50,"min":0,"max":100,"step":1},{"type":"range","id":"vertical_padding_mobile","label":"Vertical Padding Mobile","default":30,"min":0,"max":100,"step":1},{"type":"header","content":"Heading"},{"type":"select","id":"heading_type","label":"Choose Heading Size","options":[{"value":"mrk-h1","label":"H1"},{"value":"mrk-h2","label":"H2"},{"value":"mrk-h3","label":"H3"},{"value":"mrk-h4","label":"H4"},{"value":"mrk-h5","label":"H5"},{"value":"mrk-h6","label":"H6"}],"default":"mrk-h1"},{"type":"header","content":"Select Sub Heading size"},{"type":"select","id":"sub_heading","label":"Sub Heading Size","default":"p-medium","options":[{"value":"p-xl","label":"Extra Large"},{"value":"p-large","label":"Large"},{"value":"p-medium","label":"Medium"},{"value":"p-small","label":"Small"},{"value":"p-x-small","label":"Extra Small"}]},{"type":"header","content":"Select Decription size"},{"type":"select","id":"des_size","label":"Decription size","default":"p-medium","options":[{"value":"p-xl","label":"Extra Large"},{"value":"p-large","label":"Large"},{"value":"p-medium","label":"Medium"},{"value":"p-small","label":"Small"},{"value":"p-x-small","label":"Extra Small"}]}],"blocks":[{"type":"sub_heading","name":"Sub Heading","settings":[{"type":"text","id":"sub_heading","label":"Sub Heading","default":"Maniko - Explained in 2 Minutes"}]},{"type":"heading","name":"Heading","settings":[{"type":"text","id":"heading","label":"Heading","default":"What are Maniko Nails?"},{"type":"select","id":"h1_text_align","label":"Heading Text Alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"left"},{"type":"text","id":"title","label":"Title Text","default":"Your Title Here"},{"type":"range","id":"padding_top","min":1,"max":100,"step":1,"unit":"px","label":"Padding Top (Desktop)","default":20},{"type":"range","id":"padding_bottom","min":1,"max":100,"step":1,"unit":"px","label":"Padding Bottom (Desktop)","default":20},{"type":"range","id":"padding_top_tablet","min":1,"max":100,"step":1,"unit":"px","label":"Padding Top (Tablet)","default":15},{"type":"range","id":"padding_bottom_tablet","min":1,"max":100,"step":1,"unit":"px","label":"Padding Bottom (Tablet)","default":15},{"type":"range","id":"padding_top_mobile","min":1,"max":100,"step":1,"unit":"px","label":"Padding Top (Mobile)","default":10},{"type":"range","id":"padding_bottom_mobile","min":1,"max":100,"step":1,"unit":"px","label":"Padding Bottom (Mobile)","default":10}]},{"type":"details","name":"Details","settings":[{"type":"textarea","id":"details","label":"Details","default":"Whether long, short, oval or square - we love them all and show you how to get the best out of your nails thanks to our UV Gel Strips:"},{"type":"select","id":"p_text_align","label":"Paragraph Text Alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"left"},{"type":"range","id":"p_padding_top","min":1,"max":100,"step":1,"unit":"px","label":"Padding Top (Desktop)","default":10},{"type":"range","id":"p_padding_bottom","min":1,"max":100,"step":1,"unit":"px","label":"Padding Bottom (Desktop)","default":10},{"type":"range","id":"p_padding_top_tablet","min":1,"max":100,"step":1,"unit":"px","label":"Padding Top (Tablet)","default":8},{"type":"range","id":"p_padding_bottom_tablet","min":1,"max":100,"step":1,"unit":"px","label":"Padding Bottom (Tablet)","default":8},{"type":"range","id":"p_padding_top_mobile","min":1,"max":100,"step":1,"unit":"px","label":"Padding Top (Mobile)","default":5},{"type":"range","id":"p_padding_bottom_mobile","min":1,"max":100,"step":1,"unit":"px","label":"Padding Bottom (Mobile)","default":5}]},{"type":"video","name":"16:9 Photo","settings":[{"type":"range","id":"video_mt","min":0,"max":100,"step":1,"unit":"px","label":"Margin Top","default":0},{"type":"select","id":"image_ratio","label":"Image Ratio","default":"16/9","options":[{"value":"16/9","label":"16:9 (Default)"},{"value":"1/1","label":"1:1 Square"},{"value":"4/3","label":"4:3"},{"value":"3/4","label":"3:4 Portrait"},{"value":"4/5","label":"4:5 Portrait"}]},{"type":"image_picker","id":"explanation_video_poster","label":"Image","info":"Select ratio above, then upload image."}]}],"presets":[{"name":"APEX Pr Explanation Photo"}]}{% endschema %}
